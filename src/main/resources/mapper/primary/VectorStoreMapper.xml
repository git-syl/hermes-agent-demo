<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.chat.mapper.primary.VectorStoreMapper">

    <!-- 不取 embedding 列（vector(1024) 太长且无意义），只看 id/content/metadata 一行。 -->
    <select id="selectSample" resultType="java.util.Map">
        select id, content, metadata
        from vector_store
        limit 1
    </select>

</mapper>
